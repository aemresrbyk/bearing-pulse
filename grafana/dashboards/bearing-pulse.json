{
 "uid": "bearing-pulse",
 "title": "Bearing Pulse",
 "refresh": "2s",
 "time": {
  "from": "now-2m",
  "to": "now"
 },
 "schemaVersion": 39,
 "panels": [
  {
   "type": "stat",
   "title": "Device says",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 6
   },
   "datasource": {
    "type": "influxdb",
    "uid": "influx"
   },
   "targets": [
    {
     "refId": "A",
     "rawQuery": true,
     "resultFormat": "table",
     "query": "SELECT last(\"label\") AS \"label\" FROM \"model\" WHERE $timeFilter"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "/^label$/"
    },
    "colorMode": "background",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "normal": {
         "text": "NORMAL",
         "color": "green",
         "index": 0
        },
        "inner": {
         "text": "FAULT \u00b7 inner race",
         "color": "red",
         "index": 1
        },
        "outer": {
         "text": "FAULT \u00b7 outer race",
         "color": "red",
         "index": 2
        },
        "ball": {
         "text": "FAULT \u00b7 ball",
         "color": "red",
         "index": 3
        }
       }
      }
     ]
    }
   }
  },
  {
   "type": "gauge",
   "title": "Confidence",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 4,
    "h": 6
   },
   "description": "Mean of the trees' leaf probabilities for the predicted class. Below 0.6: don't trust the label, inspect.",
   "datasource": {
    "type": "influxdb",
    "uid": "influx"
   },
   "targets": [
    {
     "refId": "A",
     "rawQuery": true,
     "resultFormat": "time_series",
     "query": "SELECT last(\"confidence\") FROM \"model\" WHERE $timeFilter"
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "min": 0,
     "max": 1,
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.6
       },
       {
        "color": "green",
        "value": 0.8
       }
      ]
     }
    }
   }
  },
  {
   "type": "state-timeline",
   "title": "Prediction vs. ground truth (simulator only)",
   "gridPos": {
    "x": 10,
    "y": 0,
    "w": 14,
    "h": 6
   },
   "datasource": {
    "type": "influxdb",
    "uid": "influx"
   },
   "targets": [
    {
     "refId": "A",
     "rawQuery": true,
     "resultFormat": "table",
     "query": "SELECT \"label\" AS \"device\", \"truth\" FROM \"model\" WHERE $timeFilter"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "normal": {
         "color": "green"
        },
        "inner": {
         "color": "red"
        },
        "outer": {
         "color": "orange"
        },
        "ball": {
         "color": "purple"
        }
       }
      }
     ]
    }
   }
  },
  {
   "type": "timeseries",
   "title": "Vibration (raw, min/max per pixel)",
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "influxdb",
    "uid": "influx"
   },
   "targets": [
    {
     "refId": "A",
     "rawQuery": true,
     "resultFormat": "time_series",
     "query": "SELECT max(\"x\") AS \"max\", min(\"x\") AS \"min\" FROM \"raw\" WHERE $timeFilter GROUP BY time($__interval) fill(none)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "g",
     "custom": {
      "lineWidth": 1,
      "fillOpacity": 10
     }
    }
   }
  },
  {
   "type": "timeseries",
   "title": "RMS and kurtosis (computed on the device)",
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "influxdb",
    "uid": "influx"
   },
   "targets": [
    {
     "refId": "A",
     "rawQuery": true,
     "resultFormat": "time_series",
     "query": "SELECT \"rms\", \"kurtosis\" FROM \"features\", \"model\" WHERE $timeFilter"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*rms.*"
      },
      "properties": [
       {
        "id": "unit",
        "value": "g"
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": ".*kurtosis.*"
      },
      "properties": [
       {
        "id": "custom.axisPlacement",
        "value": "right"
       }
      ]
     }
    ]
   }
  },
  {
   "type": "timeseries",
   "title": "Band energy, log10 share of total (200 Hz bands)",
   "gridPos": {
    "x": 12,
    "y": 14,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "influxdb",
    "uid": "influx"
   },
   "targets": [
    {
     "refId": "A",
     "rawQuery": true,
     "resultFormat": "time_series",
     "query": "SELECT \"band0\", \"band1\", \"band2\", \"band3\", \"band4\", \"band5\", \"band6\", \"band7\" FROM \"features\", \"model\" WHERE $timeFilter"
    }
   ]
  }
 ]
}